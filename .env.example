# Copy this file to .env and fill in the values. seed.py and app.py both read it.

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017
# or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Secret used to sign JWTs - required. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Flask debug mode (auto-reload + error pages). Development only - leave it out or set 0 anywhere else.
# FLASK_DEBUG=1

# Optional, defaults to gymDB (seed.py always uses gymDB)
# DB_NAME=gymDB
