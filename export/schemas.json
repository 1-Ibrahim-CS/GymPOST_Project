{
  "_id": "schemas",
  "register": {
    "username": {
      "type": "string",
      "required": true,
      "min_len": 3,
      "max_len": 30,
      "pattern": "[A-Za-z0-9._-]+",
      "pattern_msg": "Use only letters, numbers, dots, underscores and hyphens"
    },
    "email": { "type": "email", "required": true, "max_len": 120 },
    "password": {
      "type": "string",
      "required": true,
      "min_len": 8,
      "max_len": 72
    },
    "plan": {
      "type": "string",
      "choices": ["Monthly", "Quarterly", "Annual", "Student"]
    },
    "name": { "type": "string", "min_len": 2, "max_len": 80, "required": true },
    "gender": {
      "type": "string",
      "choices": ["Male", "Female"],
      "required": true
    },
    "age": { "type": "int", "min": 16, "max": 100, "required": true },
    "home_branch_id": { "type": "objectid", "required": true },
    "body_metrics": {
      "type": "object",
      "schema": {
        "weight_kg": { "type": "number", "min": 30, "max": 300 },
        "height_m": { "type": "number", "min": 1.0, "max": 2.5 },
        "fat_percentage": { "type": "number", "min": 2, "max": 70 },
        "resting_bpm": { "type": "int", "min": 30, "max": 120 }
      },
      "partial": true,
      "required": false
    },
    "preferred_workout": {
      "type": "string",
      "choices": ["Cardio", "HIIT", "Strength", "Yoga"],
      "required": false
    },
    "experience_level": {
      "type": "string",
      "choices": ["Beginner", "Intermediate", "Expert"],
      "required": false
    },
    "workout_frequency": {
      "type": "int",
      "min": 0,
      "max": 7,
      "required": false
    },
    "water_intake_l": {
      "type": "number",
      "min": 0,
      "max": 10,
      "required": false
    }
  },
